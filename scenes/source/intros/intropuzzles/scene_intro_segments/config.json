  "subtitles": [
    {
      "start": 0.0,
      "end": 3.48,
      "text": "Esta prueba requiere lógica, memoria y coordinación."
    },
    {
      "start": 4.08,
      "end": 7.44,
      "text": "Vuestro objetivo será completar los colores de cada terminal."
    },
    {
      "start": 8.0,
      "end": 10.56,
      "text": "En la pantalla veréis diez combinaciones de colores."
    },
    {
      "start": 11.08,
      "end": 13.48,
      "text": "Cada combinación corresponde a un terminal."
    },
    {
      "start": 14.04,
      "end": 14.96,
      "text": "¿Cómo lo haréis?"
    },
    {
      "start": 15.52,
      "end": 18.4,
      "text": "Primero acercad vuestro token a cualquier terminal."
    },
    {
      "start": 18.96,
      "end": 23.6,
      "text": "Pulsad los botones verde, negro y rojo para descubrir vuestros tres colores."
    },
    {
      "start": 24.2,
      "end": 27.88,
      "text": "Esa combinación será siempre la misma, lo pongáis donde lo pongáis."
    },
    {
      "start": 28.76,
      "end": 31.56,
      "text": "Después, usad vuestros colores donde hagan falta."
    },
    {
      "start": 32.2,
      "end": 37.04,
      "text": "Para completar un terminal, seguramente necesitaréis combinar dos o tres tokens diferentes."
    },
    {
      "start": 37.96,
      "end": 41.84,
      "text": "Cuando los tres colores sean correctos, el terminal quedará completado."
    },
    {
      "start": 42.76,
      "end": 44.32,
      "text": "El tiempo es limitado."
    },
    {
      "start": 44.96,
      "end": 51.069,
      "text": "Descubrid vuestros colores, combinadlos bien y completad los diez terminales."
    }
  ],
